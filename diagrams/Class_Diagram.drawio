<mxfile host="app.diagrams.net"><diagram name="Class Diagram - Sistem Peminjaman Alat Lab" id="class_diagram_project"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;CLASS DIAGRAM SISTEM PEMINJAMAN ALAT LABORATORIUM KOMPUTER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #555;&quot;&gt;Arsitektur Relasi One-to-Many: 1 User Bisa Meminjam Banyak Alat dalam Satu Transaksi&lt;/span&gt;" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="40" as="geometry" /></mxCell><mxCell id="c_kategori" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;Kategori&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;- id : int&lt;br&gt;- nama_kategori : string&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;+ __construct()&lt;br&gt;+ getAllKategori(keyword: string) : array&lt;br&gt;+ getKategoriById(id: int) : array&lt;br&gt;+ createKategori(nama, deskripsi) : bool&lt;br&gt;+ updateKategori(id, nama, deskripsi) : bool&lt;br&gt;+ deleteKategori(id: int) : bool" style="shape=rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="280" height="210" as="geometry" /></mxCell><mxCell id="c_alat" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;Alat&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;- id : int&lt;br&gt;- kode : string&lt;br&gt;- id_kategori : int&lt;br&gt;- nama_alat : string&lt;br&gt;- jumlah : int&lt;br&gt;- kondisi : enum(&#39;Baik&#39;, &#39;Rusak Ringan&#39;, &#39;Rusak Berat&#39;)&lt;br&gt;- deskripsi : text&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;+ __construct()&lt;br&gt;+ getAllAlat(keyword: string) : array&lt;br&gt;+ getAlatById(id: int) : array&lt;br&gt;+ createAlat(kode, id_kat, nama, jml, kondisi, deskripsi) : bool&lt;br&gt;+ updateAlat(id, kode, id_kat, nama, jml, kondisi, deskripsi) : bool&lt;br&gt;+ deleteAlat(id: int) : bool&lt;br&gt;+ updateStok(id: int, perubahan: int) : bool" style="shape=rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="320" height="290" as="geometry" /></mxCell><mxCell id="c_detail" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;Detail_Peminjaman&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;- id : int&lt;br&gt;- id_peminjaman : int&lt;br&gt;- id_alat : int&lt;br&gt;- jumlah : int&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;+ __construct()&lt;br&gt;+ getDetailByPeminjamanId(idPmj: int) : array&lt;br&gt;+ createDetail(idPmj, idAlat, jumlah) : bool&lt;br&gt;+ deleteDetailByPeminjamanId(idPmj) : bool" style="shape=rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="320" height="210" as="geometry" /></mxCell><mxCell id="c_pengembalian" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;Pengembalian&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;- id : int&lt;br&gt;- kode_pengembalian : string&lt;br&gt;- id_peminjaman : int&lt;br&gt;- id_user : int&lt;br&gt;- tanggal_kembali : date&lt;br&gt;- waktu_kembali : time&lt;br&gt;- kondisi_kembali : string&lt;br&gt;- denda : decimal(12,2)&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;+ __construct()&lt;br&gt;+ getAllPengembalian(keyword: string) : array&lt;br&gt;+ getPengembalianById(id: int) : array&lt;br&gt;+ getPengembalianByPeminjamId(idPeminjam, keyword) : array&lt;br&gt;+ createPengembalian(idPmj, waktu, kondisi, denda, idPetugas) : int&lt;br&gt;+ updatePengembalian(id, waktu, kondisi, denda) : bool&lt;br&gt;+ deletePengembalian(id: int) : bool&lt;br&gt;+ getTotalDendaByPeminjamId(idPeminjam: int) : float" style="shape=rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="80" width="340" height="340" as="geometry" /></mxCell><mxCell id="c_user" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;- id_user : int&lt;br&gt;- nama : string&lt;br&gt;- username : string&lt;br&gt;- password : string&lt;br&gt;- role : enum(&#39;admin&#39;, &#39;admin pengelola&#39;, &#39;petugas&#39;, &#39;peminjam&#39;)&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;+ __construct()&lt;br&gt;+ getUserByUsername(username: string) : array&lt;br&gt;+ getUserById(id_user: int) : array&lt;br&gt;+ getAllUsers(keyword: string) : array&lt;br&gt;+ createUser(nama, user, pass, role) : int&lt;br&gt;+ updateUser(id, nama, user, role, pass) : bool&lt;br&gt;+ deleteUser(id_user: int) : bool&lt;br&gt;+ recordLog(id_user, aktivitas, keterangan) : bool&lt;br&gt;+ getAllLogs(keyword: string) : array" style="shape=rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="300" height="340" as="geometry" /></mxCell><mxCell id="c_peminjam" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;Peminjam&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;- id : int&lt;br&gt;- id_user : int&lt;br&gt;- nama : string&lt;br&gt;- nis : string&lt;br&gt;- kelas : string&lt;br&gt;- jurusan : string&lt;br&gt;- no_telp : string&lt;br&gt;- foto_kartu_pelajar : string&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;+ __construct()&lt;br&gt;+ getAllPeminjam(keyword: string) : array&lt;br&gt;+ getPeminjamById(id: int) : array&lt;br&gt;+ getPeminjamByUserId(id_user: int) : array&lt;br&gt;+ getPeminjamByNama(nama: string) : array&lt;br&gt;+ createPeminjam(nama, nis, kls, jur, telp, almt, id_user) : int&lt;br&gt;+ updatePeminjam(id, nama, nis, kls, jur, telp, almt) : bool&lt;br&gt;+ deletePeminjam(id: int) : bool" style="shape=rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="320" height="340" as="geometry" /></mxCell><mxCell id="c_peminjaman" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;Peminjaman&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 10px; color: #444;&quot;&gt;(Header Transaksi)&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;- id : int&lt;br&gt;- kode_peminjaman : string&lt;br&gt;- id_peminjam : int&lt;br&gt;- id_user : int&lt;br&gt;- waktu_pinjam : time&lt;br&gt;- waktu_rencana_kembali : time&lt;br&gt;- waktu_kembali : time&lt;br&gt;- jenis_peminjaman : string&lt;br&gt;- keperluan : text&lt;br&gt;- status : enum(&#39;menunggu&#39;, &#39;disetujui&#39;, &#39;dipinjam&#39;, &#39;dikembalikan&#39;, &#39;ditolak&#39;)&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;+ __construct()&lt;br&gt;+ getAllPeminjaman(keyword, statusFilter) : array&lt;br&gt;+ getPeminjamanById(id: int) : array&lt;br&gt;+ getPeminjamanByPeminjamId(idPeminjam, keyword, status) : array&lt;br&gt;+ getActivePeminjaman() : array&lt;br&gt;+ createPeminjaman(idPmj, idUsr, pinjam, kembali, jenis, kep, status) : int&lt;br&gt;+ updateStatus(id: int, status: string, id_petugas: int) : bool&lt;br&gt;+ batalkanPeminjamanByPeminjam(id: int, idPeminjam: int) : bool&lt;br&gt;+ deletePeminjaman(id: int) : bool" style="shape=rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="330" height="420" as="geometry" /></mxCell><mxCell id="c_notifikasi" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;Notifikasi&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;- id : int&lt;br&gt;- id_peminjam : int&lt;br&gt;- id_peminjaman : int&lt;br&gt;- judul : string&lt;br&gt;- pesan : text&lt;br&gt;- status : enum(&#39;belum_dibaca&#39;, &#39;dibaca&#39;)&lt;br&gt;- waktu : datetime&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#000000&quot; style=&quot;margin: 4px 0;&quot;&gt;+ __construct()&lt;br&gt;+ createNotifikasi(id_pmj, id_pmjn, judul, pesan) : bool&lt;br&gt;+ getNotifikasiByPeminjam(id_pmj, unreadOnly) : array&lt;br&gt;+ markAsRead(id: int) : bool&lt;br&gt;+ markAsReadByPeminjaman(id_peminjaman: int) : bool&lt;br&gt;+ getActiveReminderLoanIds(id_peminjam: int) : array" style="shape=rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;font